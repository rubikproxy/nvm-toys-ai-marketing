# Local app settings. The server refuses non-loopback APP_HOST values.
APP_HOST=127.0.0.1
APP_PORT=8000
APP_ENV=development
LOCAL_DATA_DIR=./data
APP_ADMIN_PASSWORD=

# Gemini remains disabled until explicitly configured. Never commit a real key.
AI_ENABLED=false
DEMO_MODE=true
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_MAX_BUDGET_INR=500
GEMINI_DAILY_BUDGET_INR=10
GEMINI_BUDGET_RESERVE_PERCENT=10
GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_MAX_INPUT_CHARS=16000
# Verify current rates at https://ai.google.dev/gemini-api/docs/pricing.
# Set rates for the configured model only after checking official pricing.
GEMINI_INPUT_USD_PER_MILLION=
GEMINI_OUTPUT_USD_PER_MILLION=
USD_TO_INR_RATE=
# Optional per-model JSON table; do not use old/assumed prices.
# GEMINI_PRICING_JSON={"verified-model-id":{"input_usd_per_million":0,"output_usd_per_million":0}}
GEMINI_PRICING_JSON={}

# Store access remains disabled until MCP authentication and protocol are verified.
NVM_TOYS_MCP_URL=https://nvmtoys.com/api/mcp
NVM_TOYS_MCP_TOKEN=
NVM_TOYS_MCP_PROTOCOL_VERSION=
ADMIN_API_TOKEN=

# D1 is a remote source of truth, never a local SQLite file.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_D1_DATABASE_ID=

# Safe defaults: no background automation, publishing, or ad spend.
ENABLE_AUTOMATION=false
ENABLE_EXTERNAL_PUBLISHING=false
ENABLE_AD_SPENDING=false

BRAND_NAME=NVM Toys
BRAND_WEBSITE=https://nvmtoys.com
LOG_LEVEL=INFO
